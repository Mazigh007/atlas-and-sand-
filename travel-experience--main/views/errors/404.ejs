<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="main" tabindex="-1">
  <section class="hero" style="min-height:76vh">
    <div class="hero-media"><img src="/img/hero-riad.jpg" alt="" onerror="this.classList.add('is-missing')"></div>
    <div class="shell hero-inner">
      <p class="eyebrow" style="color:rgba(255,255,255,.7)">Error 404 · lost in the medina</p>
      <h1 class="display">This alley<br>does not exist</h1>
      <p class="lede">The page you wanted has moved, or the link was mistyped. Both are common in a city built without straight lines.</p>
      <div class="hero-actions">
        <a class="btn" style="background:#fff;border-color:#fff;color:var(--ink)" href="/">Back to the start</a>
        <a class="btn btn--light" href="/journeys">All journeys</a>
        <a class="btn btn--light" href="/search">Search</a>
      </div>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
<%- include('../partials/widgets') %>
<script src="/js/site.js" defer></script>
</body>
</html>
