# ─── Moroccan Experience · environment ────────────────────────────────────────
# Copy to .env and fill in. Everything has a safe default so the site runs
# without any keys (Stripe and the LLM simply switch to demo/offline mode).

PORT=3000
BASE_URL=http://localhost:3000

# ── Stripe (payment gateway) ──────────────────────────────────────────────────
# Leave empty to run in DEMO checkout mode. Use a *test* secret key (sk_test_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public key only needed if you swap in Stripe.js elements later
STRIPE_PUBLISHABLE_KEY=

# ── Deposit policy ────────────────────────────────────────────────────────────
DEPOSIT_PERCENT=25
CURRENCY=usd

# ── AI chat agent (optional: the agent falls back to the built-in expert) ─────
# Either one works; Anthropic takes priority if both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_BASE_URL=

# ── Contact details shown in the chat widget, header, footer and CTAs ─────────
PHONE_MA=+212 677 926 928
PHONE_USA=+1 623 282 1221
WHATSAPP_NUMBER=212677926928
EMAIL_BOOKINGS=bookings@moroccanexperience.com
EMAIL_TEAM=hello@moroccanexperience.com

# ── Misc ─────────────────────────────────────────────────────────────────────
DATA_DIR=data/store
NODE_ENV=development
